rules_version = '2';

// =========================================================================
// samsung-brick-breaker — Firestore 보안 규칙 (통합)
//   · scores      : 헥사 블리츠(HEXA BLITZ) 기존 규칙 — 그대로 유지
//   · users       : 헥사 킹덤(HEXA KINGDOM) 플레이어 프로필 — 그대로 유지
//   · blitzScores : 헥사 킹덤 주간 블리츠 점수 — 그대로 유지
//   · cp_*        : 캐슬 팝(CASTLE POP) 전용 (아래에 추가)
// 기존 세 컬렉션의 규칙은 한 글자도 바꾸지 않았습니다.
// =========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헥사 블리츠 (기존, 변경 금지) ─────────────────────────────────
    match /scores/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'score', 'maxCombo', 'specialsCreated',
             'combosTriggered', 'mode', 'roomCode', 'createdAt'
           ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 5000000
        && request.resource.data.maxCombo is int
        && request.resource.data.maxCombo >= 0
        && request.resource.data.maxCombo <= 999
        && request.resource.data.specialsCreated is int
        && request.resource.data.specialsCreated >= 0
        && request.resource.data.specialsCreated <= 9999
        && request.resource.data.combosTriggered is int
        && request.resource.data.combosTriggered >= 0
        && request.resource.data.combosTriggered <= 9999
        && request.resource.data.mode == 'blitz60'
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() >= 1
        && request.resource.data.roomCode.size() <= 6
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ── 헥사 킹덤 · 플레이어 프로필 (기존) ───────────────────────────
    match /users/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'playerLevel', 'xp', 'coins', 'stars',
             'progressIndex', 'progressWorld', 'progressLevel',
             'roomCode', 'tasks', 'updatedAt'
           ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && request.resource.data.playerLevel is int
        && request.resource.data.playerLevel >= 1
        && request.resource.data.playerLevel <= 99
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100000000
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 100000000
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 300
        && request.resource.data.progressIndex is int
        && request.resource.data.progressIndex >= 0
        && request.resource.data.progressIndex <= 2000
        && request.resource.data.progressWorld is int
        && request.resource.data.progressWorld >= 1
        && request.resource.data.progressWorld <= 5
        && request.resource.data.progressLevel is int
        && request.resource.data.progressLevel >= 0
        && request.resource.data.progressLevel <= 20
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() <= 6
        && request.resource.data.tasks is int
        && request.resource.data.tasks >= 0
        && request.resource.data.tasks <= 100
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── 헥사 킹덤 · 주간 블리츠 점수 (기존) ──────────────────────────
    match /blitzScores/{docId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'score', 'roomCode', 'weekId',
             'mode', 'playerLevel', 'createdAt'
           ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 2000000
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() >= 1
        && request.resource.data.roomCode.size() <= 6
        && request.resource.data.weekId is string
        && request.resource.data.weekId.size() == 10
        && request.resource.data.mode == 'blitz60'
        && request.resource.data.playerLevel is int
        && request.resource.data.playerLevel >= 1
        && request.resource.data.playerLevel <= 99
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // =====================================================================
    // ── 캐슬 팝 (CASTLE POP) — cp_ 접두사 컬렉션만 사용 ────────────────
    //    · 읽기: 랭킹 공유를 위해 공개
    //    · 쓰기: 본인 문서만, 수치 범위 검증, 레벨은 한 번에 1씩만 증가
    // =====================================================================
    function cpOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
    }
    function cpLevelOk() {
      return request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 100
        && (resource == null || request.resource.data.level <= resource.data.level + 1);
    }

    // 플레이어 프로필
    match /cp_users/{uid} {
      allow read: if true;
      allow create, update: if cpOwner(uid)
        && cpLevelOk()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 10000000
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 3000
        && request.resource.data.lives is int
        && request.resource.data.lives >= 0
        && request.resource.data.lives <= 10
        && request.resource.data.area is int
        && request.resource.data.area >= 1
        && request.resource.data.area <= 5;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 전체/주간 랭킹
    match /cp_leaderboard/{uid} {
      allow read: if true;
      allow create, update: if cpOwner(uid)
        && cpLevelOk()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && request.resource.data.weeklyCrowns is int
        && request.resource.data.weeklyCrowns >= 0
        && request.resource.data.weeklyCrowns <= 100
        && request.resource.data.rushBest is int
        && request.resource.data.rushBest >= 0
        && request.resource.data.rushBest <= 200000
        && request.resource.data.weekId is string
        && request.resource.data.weekId.size() == 8;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 6자리 친구 방
    match /cp_rooms/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.members.size() <= 30;
      allow update: if request.auth != null
        && request.resource.data.members.size() <= 30;
      allow delete: if false;
    }

    // 목숨 선물
    match /cp_gifts/{giftId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.type == 'life';
      allow update: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid)
        && request.resource.data.claimed == true;
      allow delete: if false;
    }

    // 번개 러시 주간 점수
    match /cp_rush/{uid} {
      allow read: if true;
      allow create, update: if cpOwner(uid)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 200000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 하늘 경주
    match /cp_races/{raceId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
